# Brevo (contact form emails). Create under Brevo > SMTP & API > API keys.
BREVO_API_KEY=

# Cloudflare Turnstile. Create a widget for qartmina.com in the Cloudflare dashboard.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Feature flag: the partner program (/partners pages, sitemap entries, navbar and footer links). true to show.
NEXT_PUBLIC_PARTNER_PROGRAM=false
